rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // O administrador é autorizado exclusivamente por um documento criado
    // manualmente no Console do Firebase usando o UID da conta.
    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == 'mestre_shinobi@players.shinobi-chronicles.invalid'
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Cada jogador só pode ler o próprio perfil.
    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['username', 'criadoEm'])
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 20;
      allow update, delete: if false;
    }

    // Uma conta pode ter várias fichas. Cada documento tem ID próprio
    // e o proprietário é verificado por ownerUid.
    // As consultas do jogador devem usar where('ownerUid','==',uid).
    match /fichas/{fichaId} {
      allow get: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || isAdmin());

      allow list: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || isAdmin());

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      // O proprietário edita a própria ficha. Administradores autorizados
      // podem editar qualquer ficha, sem alterar o campo ownerUid.
      allow update: if signedIn()
        && resource.data.ownerUid == request.resource.data.ownerUid
        && (resource.data.ownerUid == request.auth.uid || isAdmin());

      allow delete: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Nunca permita ao navegador conceder ou remover privilégios.
    // Cadastre administradores apenas pelo Console / Admin SDK.
    match /admins/{adminId} {
      allow get: if signedIn() && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }


    // VTT: uma Mesa Permanente para todas as contas autenticadas.
    // Apenas o ADM gerencia mapas, fichas na cena e efeitos.
    // A lógica legada de convidados só se aplica às salas antigas, sem publicá-las.
    function vttMember(roomId) {
      return signedIn() && (
        roomId == 'shinobi-chronicles'
        || exists(/databases/$(database)/documents/vttRooms/$(roomId)/members/$(request.auth.uid))
      );
    }
    function vttAccess(roomId) {
      return isAdmin() || vttMember(roomId);
    }
    match /vttRooms/{roomId} {
      allow get: if vttAccess(roomId);
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name','masterUid','scene','sceneName','activeSceneId','grid','createdAt','updatedAt','turn','theatre'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80;
      allow delete: if isAdmin();
      // Biblioteca privada do mestre: jogadores recebem apenas a cena ativa no documento da sala.
      match /scenes/{sceneId} {
        allow read, create, update, delete: if isAdmin();
      }

      // O mestre publica as expressões do Teatro em um documento por ficha,
      // sem duplicar as imagens no documento da sala. Compatível com arte antiga.
      function validTheatrePortraits() {
        let source = request.resource.data.get('image', '');
        let variants = request.resource.data.get('variants', {});
        return source is string
          && source.size() <= 160000
          && variants is map
          && variants.keys().hasOnly(['casual','ninja','triste','ferido','grave'])
          && variants.get('casual', '') is string && variants.get('casual', '').size() <= 160000
          && variants.get('ninja', '') is string && variants.get('ninja', '').size() <= 160000
          && variants.get('triste', '') is string && variants.get('triste', '').size() <= 160000
          && variants.get('ferido', '') is string && variants.get('ferido', '').size() <= 160000
          && variants.get('grave', '') is string && variants.get('grave', '').size() <= 160000
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 70
          && request.resource.data.ownerUid is string;
      }
      match /theatrePortraits/{fichaId} {
        allow get: if vttAccess(roomId);
        allow list: if false;
        allow create, update: if isAdmin()
          && request.resource.data.keys().hasOnly(['image','variant','variants','name','ownerUid','updatedAt'])
          && validTheatrePortraits();
        allow delete: if isAdmin();
      }

      // O HP do Teatro é um resumo numérico público para participantes da mesa.
      // A ficha completa continua privada. Apenas o dono da ficha ou ADM escreve.
      function validTheatreVitality(fichaId) {
        return request.resource.data.keys().hasOnly(['ownerUid','current','max','updatedAt'])
          && request.resource.data.ownerUid is string
          && request.resource.data.current is number
          && request.resource.data.max is number
          && request.resource.data.max > 0 && request.resource.data.max <= 100000
          && request.resource.data.current >= 0
          && request.resource.data.current <= request.resource.data.max
          && request.resource.data.updatedAt is timestamp
          && exists(/databases/$(database)/documents/fichas/$(fichaId))
          && get(/databases/$(database)/documents/fichas/$(fichaId)).data.ownerUid == request.resource.data.ownerUid;
      }
      match /theatreVitals/{fichaId} {
        allow get: if vttAccess(roomId);
        allow list: if false;
        allow create: if vttAccess(roomId)
          && validTheatreVitality(fichaId)
          && (isAdmin() || request.auth.uid == request.resource.data.ownerUid);
        allow update: if vttAccess(roomId)
          && validTheatreVitality(fichaId)
          && resource.data.ownerUid == request.resource.data.ownerUid
          && (isAdmin() || request.auth.uid == resource.data.ownerUid);
        allow delete: if isAdmin();
      }

      match /members/{uid} {
        allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow list: if isAdmin();
        allow create, update, delete: if isAdmin();
      }
      // Tokens de cenas não ativas não podem ser lidos por jogadores.
      // A consulta do jogador DEVE incluir where('sceneId','==',activeSceneId).
      match /tokens/{tokenId} {
        function inActiveScene() {
          return vttMember(roomId)
            && resource.data.get('sceneId', '') ==
              get(/databases/$(database)/documents/vttRooms/$(roomId)).data.get('activeSceneId', '');
        }
        allow get, list: if isAdmin() || inActiveScene();
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || (
          inActiveScene()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['x','y'])
          && request.resource.data.x is number
          && request.resource.data.y is number
          && request.resource.data.x >= 0 && request.resource.data.x <= 1000
          && request.resource.data.y >= 0 && request.resource.data.y <= 1000
        );
      }
      // Quatro modos de rolagem: cada modo usa um caminho próprio.
      // Nenhuma rolagem secreta deve entrar na coleção pública 'events'.
      function validPrivateRoll() {
        let d = request.resource.data;
        return d.keys().hasOnly([
          'type','uid','mode','dice','rolls','bonus','total','label','character','at'
        ])
          && d.type == 'privateRoll'
          && d.uid is string && d.uid.size() > 0
          && d.at is timestamp
          && d.dice in ['1d6','1d8','2d8','3d8','1d10','1d12','1d20','1d100']
          && d.rolls is list && d.rolls.size() > 0 && d.rolls.size() <= 3
          && d.bonus is number && d.bonus >= -99 && d.bonus <= 99
          && d.total is number
          && d.label is string && d.label.size() <= 80
          && d.character is string && d.character.size() <= 80;
      }

      // Só o próprio dono consegue consultar suas rolagens individuais.
      // Mesmo o ADM não tem permissão de listá-las.
      match /privateRolls/{ownerUid}/entries/{rollId} {
        allow get, list: if signedIn() && request.auth.uid == ownerUid;
        allow create: if vttAccess(roomId)
          && request.auth.uid == ownerUid
          && validPrivateRoll()
          && request.resource.data.uid == ownerUid
          && request.resource.data.mode == 'self';
        allow update: if false;
        allow delete: if signedIn() && request.auth.uid == ownerUid;
      }

      // 'Para o mestre': só o ADM acessa o resultado; autor envia sem leitura.
      match /gmRolls/{rollId} {
        allow get, list: if isAdmin();
        allow create: if vttAccess(roomId)
          && validPrivateRoll()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.mode == 'gm';
        allow update: if false;
        allow delete: if isAdmin();
      }

      // Rolagem cega: jogador envia SOMENTE pedido, nunca resultado.
      // O navegador do mestre autenticado lança dados e registra o desfecho.
      function validBlindRequest() {
        let d = request.resource.data;
        return d.keys().hasOnly([
          'uid','dice','bonus','label','character','status','at'
        ])
          && d.uid == request.auth.uid
          && d.status == 'pending'
          && d.at is timestamp
          && d.dice in ['1d6','1d8','2d8','3d8','1d10','1d12','1d20','1d100']
          && d.bonus is number && d.bonus >= -99 && d.bonus <= 99
          && d.label is string && d.label.size() <= 80
          && d.character is string && d.character.size() <= 80;
      }
      match /blindRequests/{requestId} {
        allow get, list: if isAdmin();
        allow create: if vttAccess(roomId) && validBlindRequest();
        allow update: if isAdmin()
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','resolvedAt'
          ])
          && request.resource.data.status == 'resolved'
          && request.resource.data.resolvedAt is timestamp;
        allow delete: if isAdmin();
      }
      match /blindRolls/{rollId} {
        allow get, list: if isAdmin();
        allow create: if isAdmin()
          && validPrivateRoll()
          && request.resource.data.mode == 'blind';
        allow update: if false;
        allow delete: if isAdmin();
      }

      match /events/{eventId} {
        allow read: if vttAccess(roomId);
        // Jogadores podem registrar suas rolagens, mensagens e efeitos dos próprios jutsus.
        // Pedidos de perícia e efeitos livres continuam exclusivos do mestre.
        allow create: if vttAccess(roomId)
          && request.resource.data.keys().hasOnly(['type','uid','at','payload'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.payload is map
          && (
            (request.resource.data.type == 'roll'
              && request.resource.data.payload.dice is string
              && request.resource.data.payload.dice in ['1d6','1d8','2d8','3d8','1d10','1d12','1d20','1d100']
              && request.resource.data.payload.rolls is list
              && request.resource.data.payload.rolls.size() <= 3
              && request.resource.data.payload.total is number)
            || (request.resource.data.type == 'message'
              && request.resource.data.payload.text is string
              && request.resource.data.payload.text.size() <= 400)
            || (request.resource.data.type == 'rollRequest'
              && isAdmin()
              && request.resource.data.payload.targetUid is string
              && request.resource.data.payload.skill is string
              && request.resource.data.payload.skill.size() <= 70)
            || (request.resource.data.type == 'effect'
              && (isAdmin() || (
                request.resource.data.payload.get('source', '') == 'jutsu'
                && request.resource.data.payload.fichaId is string
                && exists(/databases/$(database)/documents/fichas/$(request.resource.data.payload.fichaId))
                && get(/databases/$(database)/documents/fichas/$(request.resource.data.payload.fichaId)).data.ownerUid == request.auth.uid
              ))
              && request.resource.data.payload.kind is string
              && request.resource.data.payload.kind.size() <= 28)
          );
        allow update: if isAdmin();
        // O mestre apaga todo o chat; autores podem excluir suas mensagens.
        allow delete: if isAdmin() || (
          signedIn()
          && resource.data.type == 'message'
          && resource.data.uid == request.auth.uid
        );
      }
    }

    match /perfisPublicos/{profileId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/fichas/$(profileId))
        && get(/databases/$(database)/documents/fichas/$(profileId)).data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerUid','nome','clan','vila','graduacao','portrait','notes','createdAt','updatedAt'])
        && request.resource.data.notes is list
        && request.resource.data.notes.size() <= 22;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.keys().hasOnly(['ownerUid','nome','clan','vila','graduacao','portrait','notes','createdAt','updatedAt'])
        && request.resource.data.notes is list
        && request.resource.data.notes.size() <= 22;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
    match /observacoesShinobi/{observationId} {
      allow list: if false;
      allow get: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && observationId == request.auth.uid + '__' + request.resource.data.profileId
        && request.resource.data.keys().hasOnly(['ownerUid','profileId','texto','updatedAt'])
        && request.resource.data.texto is string
        && request.resource.data.texto.size() <= 5000;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.profileId == resource.data.profileId
        && request.resource.data.keys().hasOnly(['ownerUid','profileId','texto','updatedAt'])
        && request.resource.data.texto is string
        && request.resource.data.texto.size() <= 5000;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
