rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // O administrador é autorizado exclusivamente por um documento criado
    // manualmente no Console do Firebase usando o UID da conta.
    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == 'mestre_shinobi@players.shinobi-chronicles.invalid'
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Cada jogador só pode ler o próprio perfil.
    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['username', 'criadoEm'])
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 20;
      allow update, delete: if false;
    }

    // Uma conta pode ter várias fichas. Cada documento tem ID próprio
    // e o proprietário é verificado por ownerUid.
    // As consultas do jogador devem usar where('ownerUid','==',uid).
    match /fichas/{fichaId} {
      allow get: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || isAdmin());

      allow list: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || isAdmin());

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      // O proprietário edita a própria ficha. Administradores autorizados
      // podem editar qualquer ficha, sem alterar o campo ownerUid.
      allow update: if signedIn()
        && resource.data.ownerUid == request.resource.data.ownerUid
        && (resource.data.ownerUid == request.auth.uid || isAdmin());

      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    // Nunca permita ao navegador conceder ou remover privilégios.
    // Cadastre administradores apenas pelo Console / Admin SDK.
    match /admins/{adminId} {
      allow get: if signedIn() && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }


    // VTT: uma Mesa Permanente para todas as contas autenticadas.
    // Apenas o ADM gerencia mapas, fichas na cena e efeitos.
    // A lógica legada de convidados só se aplica às salas antigas, sem publicá-las.
    function vttMember(roomId) {
      return signedIn() && (
        roomId == 'shinobi-chronicles'
        || exists(/databases/$(database)/documents/vttRooms/$(roomId)/members/$(request.auth.uid))
      );
    }
    function vttAccess(roomId) {
      return isAdmin() || vttMember(roomId);
    }
    match /vttRooms/{roomId} {
      allow get: if vttAccess(roomId);
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name','scene','sceneName','activeSceneId','grid','createdAt','updatedAt','turn','theatre'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80;
      allow delete: if isAdmin();
      // Biblioteca privada do mestre: jogadores recebem apenas a cena ativa no documento da sala.
      match /scenes/{sceneId} {
        allow read, create, update, delete: if isAdmin();
      }
      match /members/{uid} {
        allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow list: if isAdmin();
        allow create, update, delete: if isAdmin();
      }
      // Tokens de cenas não ativas não podem ser lidos por jogadores.
      // A consulta do jogador DEVE incluir where('sceneId','==',activeSceneId).
      match /tokens/{tokenId} {
        function inActiveScene() {
          return vttMember(roomId)
            && resource.data.get('sceneId', '') ==
              get(/databases/$(database)/documents/vttRooms/$(roomId)).data.get('activeSceneId', '');
        }
        allow get, list: if isAdmin() || inActiveScene();
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || (
          inActiveScene()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['x','y'])
          && request.resource.data.x is number
          && request.resource.data.y is number
          && request.resource.data.x >= 0 && request.resource.data.x <= 1000
          && request.resource.data.y >= 0 && request.resource.data.y <= 1000
        );
      }
      match /events/{eventId} {
        allow read: if vttAccess(roomId);
        allow create: if vttAccess(roomId)
          && request.resource.data.keys().hasOnly(['type','uid','at','payload'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.type in ['roll','effect']
          && (request.resource.data.type == 'roll' || isAdmin());
        allow update, delete: if isAdmin();
      }
    }

    match /perfisPublicos/{profileId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/fichas/$(profileId))
        && get(/databases/$(database)/documents/fichas/$(profileId)).data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerUid','nome','clan','vila','graduacao','portrait','notes','createdAt','updatedAt'])
        && request.resource.data.notes is list
        && request.resource.data.notes.size() <= 22;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.keys().hasOnly(['ownerUid','nome','clan','vila','graduacao','portrait','notes','createdAt','updatedAt'])
        && request.resource.data.notes is list
        && request.resource.data.notes.size() <= 22;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
    match /observacoesShinobi/{observationId} {
      allow list: if false;
      allow get: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && observationId == request.auth.uid + '__' + request.resource.data.profileId
        && request.resource.data.keys().hasOnly(['ownerUid','profileId','texto','updatedAt'])
        && request.resource.data.texto is string
        && request.resource.data.texto.size() <= 5000;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.profileId == resource.data.profileId
        && request.resource.data.keys().hasOnly(['ownerUid','profileId','texto','updatedAt'])
        && request.resource.data.texto is string
        && request.resource.data.texto.size() <= 5000;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
